# ── Wallet / Deployment ────────────────────────────────────
# Your deployer wallet private key (for contract deployment only)
# NEVER commit this file with a real key
PRIVATE_KEY=your_private_key_here

# ── App ───────────────────────────────────────────────────
# The deployed InkGhost contract address (filled after deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Mock USDC address (testnet only — printed by deploy-testnet.js)
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
# Ink chain to use: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=testnet
# Your app URL (for generating payment links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Privy (embedded wallets for buyers) ───────────────────
# Sign up at https://privy.io → create app → copy App ID
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# ── WalletConnect (for sellers connecting existing wallets) ─
# Get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
